{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NUVANX Clinical Commercial Offers",
  "description": "Single source of truth for clinical and commercial parameters - consumed by hubs, fichas, FAQ, and schema",
  "type": "object",
  "patternProperties": {
    "^[a-z0-9_]+$": {
      "type": "object",
      "description": "Unique offer identifier (e.g., biostimulator_sculptra_face)",
      "properties": {
        "offer_id": {
          "type": "string",
          "description": "Unique offer identifier"
        },
        "treatment": {
          "type": "string",
          "description": "Treatment name"
        },
        "product_family": {
          "type": "string",
          "enum": ["Endolift®", "endolaser", "laser_co2", "exion", "labios_ha", "ojeras_ha", "rinomodelacion_ha", "bioestimuladores", "neuromoduladores", "btl_exilite", "emfusion"],
          "description": "Product family category"
        },
        "product": {
          "type": "string",
          "description": "Specific product within family"
        },
        "zone": {
          "type": "string",
          "enum": ["facial", "corporal", "cuello", "manos", "ojeras", "nariz", "body"],
          "description": "Treatment zone"
        },
        "price": {
          "type": "number",
          "minimum": 0,
          "description": "Price in EUR"
        },
        "unit": {
          "type": "string",
          "enum": ["session", "pack", "procedure"],
          "description": "Pricing unit"
        },
        "sessions": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of sessions recommended"
        },
        "interval": {
          "type": "string",
          "description": "Time interval between sessions (e.g., '2 weeks')"
        },
        "downtime": {
          "type": "string",
          "description": "Expected downtime/recovery period"
        },
        "duration": {
          "type": "string",
          "description": "Treatment duration per session"
        },
        "schema": {
          "type": "object",
          "description": "Schema.org structured data configuration",
          "properties": {
            "key": {
              "type": "string",
              "description": "Schema key for treatment-hub"
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Schema.org types"
            },
            "procedureType": {
              "type": "string",
              "description": "Schema.org procedure type"
            },
            "path": {
              "type": "string",
              "description": "URL path for this treatment"
            }
          }
        },
        "catalog": {
          "type": "object",
          "description": "Catalog display configuration",
          "properties": {
            "meta": {
              "type": "string",
              "description": "Catalog meta label"
            },
            "title": {
              "type": "string",
              "description": "Catalog display title"
            },
            "body": {
              "type": "string",
              "description": "Catalog description"
            },
            "url": {
              "type": "string",
              "description": "Catalog URL"
            }
          }
        }
      },
      "required": ["offer_id", "treatment", "product_family", "zone", "price", "unit"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}