{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NUVANX Gate Normalization Configuration",
  "description": "Defines the complete set of mandatory gates that must run on every release candidate. No workflow 'green' should mean lower coverage than another.",
  "version": "1.0.0",
  "_ci_status": "validate-gate-normalization.mjs exists but is NOT invoked by any workflow (staging.yml / production.yml). Must be wired to CI before these gates are enforced.",
  "mandatory_gates": {
    "code_quality": {
      "php_syntax": {
        "required": true,
        "description": "PHP syntax validation",
        "command": "php -l"
      },
      "phpcs": {
        "required": true,
        "description": "PHP CodeSniffer code style",
        "command": "phpcs"
      },
      "phpstan": {
        "required": true,
        "description": "PHPStan static analysis",
        "command": "phpstan analyse"
      }
    },
    "security": {
      "secrets": {
        "required": true,
        "description": "No secrets in code",
        "command": "git grep -i 'password|api_key|secret'"
      },
      "gitleaks": {
        "required": true,
        "description": "Gitleaks secret scanning",
        "command": "gitleaks detect"
      }
    },
    "theme_hygiene": {
      "required": true,
      "description": "Theme hygiene diagnostic",
      "command": "wp eval require 'tools/migrations/diagnose-jsonld-storage.php';",
      "_status": "MISSING — tools/migrations/diagnose-jsonld-storage.php does not exist in repo"
    },
    "data_catalog": {
      "required": true,
      "description": "Data/catalog validation",
      "command": "jq empty"
    },
    "publication_topology": {
      "required": true,
      "description": "Publication manifest validation",
      "command": "wp eval require 'tools/migrations/generate-publication-manifest.php';"
    },
    "seo_schema": {
      "required": true,
      "description": "SEO/Schema validation",
      "command": "jq empty"
    },
    "block_c": {
      "required": true,
      "description": "Block C origin browser fallback",
      "command": "node scripts/staging2/block-c-origin-browser-fallback.mjs",
      "_status": "MISSING — scripts/staging2/block-c-origin-browser-fallback.mjs does not exist in repo"
    },
    "hubspot": {
      "required": true,
      "description": "HubSpot specific gate",
      "command": "node scripts/staging2/test-hubspot-specific-gate.mjs",
      "optional_tool": "agent-browser"
    },
    "visual_states": {
      "required": true,
      "description": "Visual QA by state",
      "command": "node scripts/staging2/visual-qa-by-state.mjs",
      "optional_tool": "agent-browser"
    },
    "editorial_gate": {
      "required": true,
      "description": "Editorial gate pre-publication",
      "command": "wp eval require 'tools/migrations/editorial-gate-validation.php';"
    },
    "overlays_governance": {
      "required": true,
      "description": "Overlays/plugins design system audit",
      "command": "node scripts/staging2/audit-overlays-design-system.mjs",
      "optional_tool": "agent-browser",
      "_status": "MISSING — scripts/staging2/audit-overlays-design-system.mjs does not exist in repo"
    }
  },
  "workflows": {
    "staging": {
      "required_gates": ["code_quality", "security", "theme_hygiene", "data_catalog", "publication_topology", "seo_schema", "block_c", "hubspot", "visual_states", "editorial_gate"],
      "always_run": true
    },
    "production": {
      "required_gates": ["code_quality", "security", "theme_hygiene", "data_catalog", "publication_topology", "seo_schema", "block_c", "hubspot", "visual_states", "editorial_gate", "overlays_governance", "production_parity"],
      "always_run": true
    },
    "pre_merge": {
      "required_gates": ["code_quality", "security", "theme_hygiene", "data_catalog", "publication_topology", "seo_schema"],
      "always_run": true
    }
  },
  "rules": {
    "no_conditional_gates": "All mandatory gates must run regardless of workflow parameters",
    "no_opt_in_quality": "Deep quality gates cannot be optional",
    "same_coverage": "All workflows must have same gate coverage for the same SHA",
    "optional_tools": "Gates requiring optional tools (agent-browser) can skip gracefully but must be defined"
  }
}